# PostgreSQL 14+ with the pg_trgm extension (created by the first migration)
DATABASE_URL="postgresql://igidi:igidi@localhost:5432/igidi?schema=public"

# Admin session lifetime (hours)
SESSION_TTL_HOURS=12

# Where uploaded files are stored (outside the web root; served through /api/media/:id)
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB=25

# First administrator (used by `npm run db:seed` only). Leave the password empty
# to have a random one generated and printed once. It must be changed at first login.
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD=""

# Only for local testing over plain HTTP in production mode
# INSECURE_COOKIES=1
